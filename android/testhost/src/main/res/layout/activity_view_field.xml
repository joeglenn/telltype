<?xml version="1.0" encoding="utf-8"?>
<!-- One field screen for the View-based field types. The ids are stable: UI Automator and the :platform tests find
     the field under test as "field", a second plain field as "other_field", a button outside the overlay as
     "tap_target" (its label counts taps) and "close", which finishes the screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/field_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/field"
        android:text="@string/field_label" />

    <net.jbglenn.telltype.testhost.HostEditText
        android:id="@+id/field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="text"
        android:minHeight="48dp" />

    <TextView
        android:id="@+id/other_field_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/other_field"
        android:text="@string/other_field_label" />

    <EditText
        android:id="@+id/other_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="text"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/tap_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_target_initial" />

    <Button
        android:id="@+id/close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close" />
</LinearLayout>
